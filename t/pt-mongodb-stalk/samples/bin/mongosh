#!/usr/bin/env bash
# Fake mongosh for the pt-mongodb-stalk tests.  The tool runs it as
# "mongosh --nodb --quiet <script>.js".  MONGOSH_ARGS_LOG records only the
# command lines; MONGOSH_LOG also records the scripts.
script_file="${@: -1}"
script="$(cat "$script_file" 2>/dev/null)"
[ -n "${MONGOSH_ARGS_LOG:-}" ] && printf '%s\n' "$*" >> "$MONGOSH_ARGS_LOG"
[ -n "${MONGOSH_LOG:-}" ] && printf '%s\n%s\n' "$*" "$script" >> "$MONGOSH_LOG"

# The collection scripts write their files themselves; act them out.
p_dir="$(sed -n "s/^const P_DIR = '\(.*\)';\$/\1/p" "$script_file")"
p_prefix="$(sed -n "s/^const P_PREFIX = '\(.*\)';\$/\1/p" "$script_file")"
p_count="$(sed -n 's/^const P_COUNT = \([0-9]*\);$/\1/p' "$script_file")"
p_tmpdir="$(sed -n "s/^const P_TMPDIR = '\(.*\)';\$/\1/p" "$script_file")"
case "$script" in
   *"__try('hostInfo'"*)
      # FAKE_ONCE_BLOCK: hang for that many seconds before reporting anything,
      # like a stalled server.
      [ -n "${FAKE_ONCE_BLOCK:-}" ] && sleep "$FAKE_ONCE_BLOCK"
      printf 'TS 1.0 2026-01-01 00:00:00\n{"hostname": "fake"}\n' >> "$p_dir/$p_prefix-hostinfo"
      # The server's PID, log file, port and start time: by default, the
      # mongod in FAKE_PROCS (see procs.sh), which started 1000 seconds ago.
      printf '%s||%s|%s\n' "${FAKE_SERVER_PID:-4242}" "${FAKE_SERVER_PORT:-27018}" \
         "$(($(date +%s) - ${FAKE_SERVER_UPTIME:-1000}))" > "$p_tmpdir/mongo-server"
      exit 0
      ;;
   *"for (let i = 0; i < P_COUNT"*)
      # FAKE_BLOCK: hang for that many seconds, like a stalled server.
      [ -n "${FAKE_BLOCK:-}" ] && sleep "$FAKE_BLOCK"
      i=0
      while [ "$i" -lt "$p_count" ]; do
         printf 'TS 1.0 2026-01-01 00:00:00\n{"connections": {"active": 2}}\n' >> "$p_dir/$p_prefix-serverstatus"
         printf '+---+\n| Variable_name | Value |\n+---+\n| connections.active | 2 |\n+---+\n\n' >> "$p_dir/$p_prefix-serverstatus-ext"
         printf 'TS 1.0 2026-01-01 00:00:00\n{"inprog": []}\n' >> "$p_dir/$p_prefix-currentop"
         i=$((i + 1))
      done
      exit 0
      ;;
esac

case "$script" in
   *"print('identity|'"*)
      # The server's identity, for the process triggers.
      printf 'identity|%s|%s|%s\n' "${FAKE_SERVER_PID:-4242}" "${FAKE_SERVER_PORT:-27018}" \
         "$(($(date +%s) - ${FAKE_SERVER_UPTIME:-1000}))"
      ;;
   *"__serverStatus.process"*)
      # Topology: a replica set member with no cluster role.
      printf 'mongod||PRIMARY|rs0\n'
      ;;
   *"currentOp: 1"*)
      printf '{"inprog":[]}\n'
      ;;
   *"serverStatus: 1"*)
      printf '{"process":"mongod","connections":{"current":5,"active":2},"globalLock":{"currentQueue":{"writers":0}}}\n'
      ;;
   *"replSetGetStatus: 1"*)
      printf '{"members":[]}\n'
      ;;
esac
exit 0
